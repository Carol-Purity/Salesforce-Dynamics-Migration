# Copy this file to .env and fill it in. .env is git-ignored - never commit it.

# --- Salesforce (Developer Edition) -------------------------------------------
SF_USERNAME=you@yourname-dev.com
SF_PASSWORD=your-password
# Setup > My Personal Information > Reset My Security Token (emailed to you)
SF_SECURITY_TOKEN=
# "login" for production/Developer Edition, "test" for a sandbox
SF_DOMAIN=login

# --- Dynamics 365 / Dataverse ---------------------------------------------------
# Power Platform admin center > Environments > your trial > Environment URL
DATAVERSE_URL=https://yourorg.crm4.dynamics.com

# Logical name of the "Salesforce Id" column you created (Step 2.4), e.g. cr8a1_salesforceid
SF_ID_COLUMN=

# Leave the three lines below blank to sign in with your own trial user (device code).
# Fill them in only if you created an app registration (docs/02-set-up-dynamics.md, option B).
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
